  </ItemGroup>

  <ItemGroup>
    <None Update="OfferReportHeader.xsd">
      <LastGenOutput>OfferReportHeader.Designer.cs</LastGenOutput>
      <Generator>MSDataSetGenerator</Generator>
    </None>
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties appsettings_1development_1json__JsonSchema="" /></VisualStudio></ProjectExtensions>

